{
  "name": "ideapilot",
  "version": "1.0.0",
  "description": "IdeaPilot: turn ideas into visual maps, actionable plans and trackable tasks.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/**/*.test.js\"",
    "dev:memory": "node scripts/dev-memory.js",
    "vendor": "node scripts/copy-vendor.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@google/genai": "^2.29.1",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.8",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "cytoscape": "^3.34.3",
    "dotenv": "^18.0.8",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide": "^1.57.0",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "nodemonConfig": {
    "ext": "js,ejs,json",
    "ignore": [
      "public/*",
      "tests/*"
    ]
