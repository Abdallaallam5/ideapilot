<% const SOURCE = { manual: 'Manual', ai: 'AI', replan: 'Replan', restore: 'Restore', initial: 'Initial' }; %>
<div class="ws-page">
  <div class="ws-page-head">
    <div><h1><%= __('History') %></h1><p><%= __('Plan versions, decisions, suggestions you reviewed, and everything that happened in this project.') %></p></div>
  </div>

  <% const pending = proposals.filter(function (p) { return p.status === 'pending'; }); if (pending.length) { %>
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
      <i data-lucide="inbox" class="icon-sm"></i>
      <strong><%= __('{n} proposal(s) waiting for your review:', { n: pending.length }) %></strong>
      <% pending.forEach(function (p) { %><a class="btn btn-sm btn-light" href="/projects/<%= project._id %>/proposals/<%= p._id %>"><%= __(p.title) %></a><% }) %>
    </div>
  <% } %>

  <div class="row g-3">
    <div class="col-xl-7">
      <section class="panel mb-3" aria-labelledby="versions-title">
        <div class="panel-head">
          <h2 id="versions-title"><i data-lucide="git-branch" class="icon-sm"></i> <%= __('Plan versions') %></h2>
          <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#saveVersion" aria-expanded="false"><%= __('Save current as version') %></button>
        </div>
        <div class="collapse" id="saveVersion">
          <form class="panel-body border-bottom" action="/projects/<%= project._id %>/plan/versions" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <input type="hidden" name="returnTo" value="history">
            <label class="form-label" for="vSummary"><%= __('What changed, or why are you saving?') %></label>
            <div class="d-flex gap-2"><input class="form-control" id="vSummary" name="changeSummary" maxlength="2000" required><button class="btn btn-primary" type="submit"><%= __('Save') %></button></div>
          </form>
        </div>
        <% versions.forEach(function (v) { %>
          <div class="version-row <%= v.status === 'current' ? 'current' : '' %>">
            <span class="version-num">v<%= v.version %></span>
            <div class="flex-grow-1" style="min-width: 200px">
              <div class="fw-semibold"><%= __(v.title) %> <% if (v.status === 'current') { %><span class="badge text-bg-primary ms-1"><%= __('Current') %></span><% } %> <span class="source-tag ms-1"><%= __(SOURCE[v.source] || v.source) %></span></div>
              <div class="small text-muted"><%= __(v.changeSummary) %></div>
              <div class="small text-muted"><%= fmt.formatDateTime(v.createdAt) %><%= v.createdBy ? ' · ' + v.createdBy.name : '' %> · <%= __('{n} phase(s)', { n: v.phaseCount }) %> · <%= __('{n} task(s)', { n: v.taskCount }) %><%= v.completedCount !== null ? ' (' + __('{n} completed', { n: v.completedCount }) + ')' : '' %></div>
            </div>
            <div class="d-flex gap-2">
              <a class="btn btn-light btn-sm" href="/projects/<%= project._id %>/plan/versions/<%= v._id %>"><%= __('View') %></a>
              <% if (v.status !== 'current') { %>
                <form id="restore-<%= v._id %>" action="/projects/<%= project._id %>/plan/versions/<%= v._id %>/restore" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"></form>
                <button class="btn btn-outline-primary btn-sm" type="button" data-confirm="<%= __('Restore version {v}? Its phases and tasks become a new current version. Your current plan (v{current}) is saved in history first, so you can switch back.', { v: v.version, current: project.currentPlanVersion }) %>" data-confirm-label="<%= __('Restore') %>" data-confirm-tone="primary" data-confirm-form="#restore-<%= v._id %>"><%= __('Restore') %></button>
              <% } %>
            </div>
          </div>
        <% }) %>
      </section>

      <section class="panel mb-3" id="decisions" aria-labelledby="decisions-title">
        <div class="panel-head">
          <h2 id="decisions-title"><i data-lucide="gavel" class="icon-sm"></i> <%= __('Decisions') %></h2>
          <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#newDecision" aria-expanded="false"><%= __('Record a decision') %></button>
        </div>
        <div class="collapse" id="newDecision">
          <form class="panel-body border-bottom" action="/projects/<%= project._id %>/decisions" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <div class="mb-2"><label class="form-label" for="dTitle"><%= __('Decision') %></label><input class="form-control" id="dTitle" name="title" maxlength="200" required placeholder="<%= __('e.g. Launch online first, physical store later') %>"></div>
            <div class="mb-2"><label class="form-label" for="dRationale"><%= __('Rationale') %> <span class="optional"><%= __('optional') %></span></label><textarea class="form-control" id="dRationale" name="rationale" rows="2" maxlength="4000"></textarea></div>
            <div class="row g-2 mb-2">
              <div class="col-md-6"><label class="form-label" for="dStatus"><%= __('Status') %></label><select class="form-select" id="dStatus" name="status"><% C.DECISION_STATUSES.forEach(function (s) { %><option value="<%= s %>" <%= s === 'accepted' ? 'selected' : '' %>><%= fmt.label(s) %></option><% }) %></select></div>
              <div class="col-md-6"><label class="form-label" for="dNode"><%= __('Related map node') %></label><select class="form-select" id="dNode" name="relatedNode"><option value=""><%= __('None') %></option><% nodes.forEach(function (n) { %><option value="<%= n._id %>"><%= n.title %> (<%= fmt.label(n.type) %>)</option><% }) %></select></div>
            </div>
            <button class="btn btn-primary btn-sm" type="submit"><%= __('Record decision') %></button>
          </form>
        </div>
        <div class="panel-body">
          <% if (!decisions.length) { %><p class="text-muted small mb-0"><%= __('No decisions recorded yet. Accepted replans are recorded here automatically.') %></p><% } %>
          <% decisions.forEach(function (d) { %>
            <div class="d-flex gap-3 align-items-start mb-3">
              <span class="status-badge <%= d.status === 'accepted' ? 'status-completed' : d.status === 'rejected' ? 'status-blocked' : 'status-todo' %>"><%= fmt.label(d.status) %></span>
              <div class="flex-grow-1">
                <div class="fw-semibold"><%= __(d.title) %></div>
                <% if (d.rationale) { %><div class="small text-muted" style="white-space: pre-line"><%= __(d.rationale) %></div><% } %>
                <div class="small text-muted"><%= fmt.formatDateTime(d.createdAt) %><%= d.planVersion ? ' · ' + __('plan v{v}', { v: d.planVersion }) : '' %><% if (d.relatedNode) { %> · <a href="/projects/<%= project._id %>/map#node-<%= d.relatedNode._id %>"><%= d.relatedNode.title %></a><% } %></div>
              </div>
              <form action="/projects/<%= project._id %>/decisions/<%= d._id %>/update" method="post" class="d-flex">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <label class="visually-hidden" for="ds-<%= d._id %>"><%= __('Change status') %></label>
                <select class="form-select form-select-sm" id="ds-<%= d._id %>" name="status" data-autosubmit>
                  <% C.DECISION_STATUSES.forEach(function (s) { %><option value="<%= s %>" <%= d.status === s ? 'selected' : '' %>><%= fmt.label(s) %></option><% }) %>
                </select>
              </form>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="panel" id="proposals" aria-labelledby="proposals-title">
        <div class="panel-head"><h2 id="proposals-title"><i data-lucide="inbox" class="icon-sm"></i> <%= __('Suggestions and proposals') %></h2></div>
        <div class="panel-body">
          <% if (!proposals.length) { %><p class="text-muted small mb-0"><%= __('No proposals yet. They appear when you replan or use the AI copilot.') %></p><% } %>
          <% proposals.forEach(function (p) { %>
            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
              <span class="status-badge <%= p.status === 'accepted' ? 'status-completed' : p.status === 'rejected' ? 'status-blocked' : 'status-in_progress' %>"><%= fmt.label(p.status) %></span>
              <span class="source-tag"><%= __(p.origin === 'ai' ? 'AI' : 'Replan') %></span>
              <a class="fw-semibold" href="/projects/<%= project._id %>/proposals/<%= p._id %>"><%= __(p.title) %></a>
              <span class="small text-muted ms-auto"><%= fmt.timeAgo(p.createdAt) %><%= p.resultPlanVersion ? ' · ' + __('created v{v}', { v: p.resultPlanVersion }) : '' %></span>
            </div>
            <% if (p.appliedSummary) { %><div class="small text-muted mb-2 ms-1"><%= __(p.appliedSummary) %></div><% } %>
          <% }) %>
        </div>
      </section>
    </div>

    <div class="col-xl-5">
      <section class="panel" aria-labelledby="activity-title">
        <div class="panel-head"><h2 id="activity-title"><i data-lucide="activity" class="icon-sm"></i> <%= __('Activity') %></h2><span class="small text-muted"><%= __('{n} event(s)', { n: activityPage.total }) %></span></div>
        <div class="panel-body">
          <% if (!activityPage.items.length) { %><p class="text-muted small mb-0"><%= __('No activity yet.') %></p><% } %>
          <ul class="timeline">
            <% activityPage.items.forEach(function (a) { %>
              <li><div class="small"><%= __(a.message) %></div><div class="when" title="<%= fmt.formatDateTime(a.createdAt) %>"><%= fmt.timeAgo(a.createdAt) %></div></li>
            <% }) %>
          </ul>
          <% if (activityPage.pages > 1) { %>
            <nav class="d-flex justify-content-between mt-2" aria-label="<%= __('Activity pages') %>">
              <% if (activityPage.page > 1) { %><a class="btn btn-light btn-sm" href="?page=<%= activityPage.page - 1 %>"><%= __('Newer') %></a><% } else { %><span></span><% } %>
              <span class="small text-muted align-self-center"><%= __('Page {page} of {pages}', { page: activityPage.page, pages: activityPage.pages }) %></span>
              <% if (activityPage.page < activityPage.pages) { %><a class="btn btn-light btn-sm" href="?page=<%= activityPage.page + 1 %>"><%= __('Older') %></a><% } else { %><span></span><% } %>
            </nav>
          <% } %>
        </div>
      </section>
    </div>
  </div>
</div>
