<%# Generic confirmation modal. Buttons with data-confirm open it and submit their form on confirm. %>
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="confirmModalTitle"><%= __('Are you sure?') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= __('Close') %>"></button>
      </div>
      <div class="modal-body"><p class="mb-0" data-confirm-message><%= __('This action cannot be undone.') %></p></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal"><%= __('Cancel') %></button>
        <button type="button" class="btn btn-danger" data-confirm-accept><%= __('Confirm') %></button>
      </div>
    </div>
  </div>
</div>
