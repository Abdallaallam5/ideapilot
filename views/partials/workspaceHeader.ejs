<header class="ws-header">
  <div class="ws-header-left">
    <a class="ws-brand" href="/dashboard" aria-label="<%= __('Back to dashboard') %>"><%- include('logo') %></a>
    <span class="ws-sep d-none d-md-inline" aria-hidden="true">/</span>
    <div class="ws-title-wrap" data-project-editor data-update-url="/projects/<%= project._id %>/update">
      <label class="visually-hidden" for="wsTitle"><%= __('Project title') %></label>
      <input id="wsTitle" class="ws-title-input" name="title" value="<%= project.title %>" maxlength="140" autocomplete="off" data-original="<%= project.title %>">
      <button class="ws-desc-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#wsDescription" aria-expanded="false" aria-controls="wsDescription" title="<%= __('Edit description') %>">
        <i data-lucide="align-left" class="icon-sm"></i><span class="visually-hidden"><%= __('Edit description') %></span>
      </button>
    </div>
  </div>
  <div class="ws-header-right">
    <span class="save-status" data-save-status data-state="saved" role="status" aria-live="polite"><i data-lucide="cloud" class="icon-sm"></i><span><%= __('All changes saved') %></span></span>
    <span class="ws-progress d-none d-lg-flex" title="<%= __('{done} of {total} tasks completed', { done: stats.completed, total: stats.total }) %>">
      <span class="ws-progress-bar"><span style="width: <%= stats.progress %>%"></span></span><span data-progress-label><%= stats.progress %>%</span>
    </span>
    <button class="btn btn-copilot btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#aiPanel" aria-controls="aiPanel">
      <i data-lucide="sparkles" class="icon-sm"></i><span class="d-none d-sm-inline"><%= __('Copilot') %></span>
    </button>
    <%- include('langToggle', { toggleClass: 'btn btn-ws-icon btn-sm' }) %>
    <div class="dropdown">
      <button class="btn btn-ws-icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= __('Project and account menu') %>"><i data-lucide="more-vertical" class="icon-sm"></i></button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="/projects/<%= project._id %>/edit"><i data-lucide="pencil" class="icon-sm me-2"></i><%= __('Edit project details') %></a></li>
        <li><a class="dropdown-item" href="/dashboard"><i data-lucide="layout-grid" class="icon-sm me-2"></i><%= __('Dashboard') %></a></li>
        <li><a class="dropdown-item" href="/settings"><i data-lucide="settings" class="icon-sm me-2"></i><%= __('Settings') %></a></li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <form action="/logout" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <button class="dropdown-item" type="submit"><i data-lucide="log-out" class="icon-sm me-2"></i><%= __('Log out ({name})', { name: currentUser.name }) %></button>
          </form>
        </li>
      </ul>
    </div>
  </div>
  <div class="collapse ws-description" id="wsDescription">
    <label class="form-label small" for="wsDescriptionInput"><%= __('Description') %></label>
    <textarea id="wsDescriptionInput" class="form-control" rows="3" maxlength="5000" data-description-input><%= project.description %></textarea>
    <div class="d-flex justify-content-end mt-2 gap-2">
      <button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse" data-bs-target="#wsDescription"><%= __('Close') %></button>
      <button class="btn btn-sm btn-primary" type="button" data-save-description><%= __('Save description') %></button>
    </div>
  </div>
</header>
