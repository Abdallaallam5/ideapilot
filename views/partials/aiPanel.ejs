<aside class="offcanvas offcanvas-end ai-panel" tabindex="-1" id="aiPanel" aria-labelledby="aiPanelTitle" data-ai-panel data-project-id="<%= project._id %>" data-ai-enabled="<%= aiStatus.enabled %>">
  <div class="offcanvas-header">
    <h2 class="offcanvas-title fs-5 d-flex align-items-center gap-2" id="aiPanelTitle"><i data-lucide="sparkles"></i> <%= __('IdeaPilot Assistant') %></h2>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="<%= __('Close') %>"></button>
  </div>
  <div class="offcanvas-body">
    <% if (!aiStatus.enabled) { %>
      <div class="ai-disabled">
        <i data-lucide="plug-zap" class="mb-2"></i>
        <h3 class="fs-6"><%= __('The IdeaPilot assistant is not turned on') %></h3>
        <p class="small mb-2"><%= __(aiStatus.reason) %></p>
        <p class="small mb-0"><%= __('Everything else works without it: you can build maps, analyses, roadmaps and tasks by hand. To turn on the assistant, the server administrator sets AI_PROVIDER, AI_API_KEY and optionally AI_MODEL in the environment and restarts the app.') %></p>
      </div>
    <% } else { %>
      <p class="small ai-muted"><%= __('The assistant only proposes changes. You review and approve them before anything in your project changes.') %></p>
      <div class="ai-actions">
        <% const actions = [
          { url: 'analyze', label: 'Analyze this idea', icon: 'scan-search', hint: 'Summary, goals, assumptions, risks' },
          { url: 'graph', focus: 'components', label: 'Suggest missing components', icon: 'puzzle', hint: 'New nodes for the map' },
          { url: 'graph', focus: 'risks', label: 'Find risks and assumptions', icon: 'shield-alert', hint: 'Adds them to the map' },
          { url: 'graph', focus: 'full', label: 'Generate a full idea map', icon: 'network', hint: 'Proposes a complete graph' },
          { url: 'graph', focus: 'alternatives', label: 'Suggest alternative approaches', icon: 'git-fork', hint: 'Connected as alternatives' },
          { url: 'roadmap', label: 'Generate a roadmap', icon: 'milestone', hint: 'Phases, milestones, tasks' },
          { url: 'tasks', label: 'Improve my tasks', icon: 'list-checks', hint: 'Clearer tasks, missing work' },
        ]; %>
        <% actions.forEach(function (a) { %>
          <form action="/projects/<%= project._id %>/ai/<%= a.url %>" method="post" data-ai-form>
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <% if (a.focus) { %><input type="hidden" name="focus" value="<%= a.focus %>"><% } %>
            <button class="ai-action" type="submit">
              <i data-lucide="<%= a.icon %>"></i>
              <span><strong><%= __(a.label) %></strong><small><%= __(a.hint) %></small></span>
            </button>
          </form>
        <% }) %>
      </div>
      <hr>
      <h3 class="fs-6"><%= __('Ask IdeaPilot') %></h3>
      <div class="ai-chat" data-ai-chat>
        <div class="ai-messages" data-ai-messages aria-live="polite"></div>
        <form class="ai-chat-form" data-ai-chat-form>
          <label class="visually-hidden" for="aiQuestion"><%= __('Question') %></label>
          <textarea id="aiQuestion" class="form-control" rows="2" maxlength="2000" placeholder="<%= __('e.g. What should I validate first?') %>" required></textarea>
          <div class="d-flex gap-2 mt-2 flex-wrap">
            <button class="btn btn-sm btn-primary" type="submit" data-mode="ask"><%= __('Ask') %></button>
            <button class="btn btn-sm btn-outline-light" type="button" data-ai-preset="explain"><%= __('Explain relationships') %></button>
            <button class="btn btn-sm btn-outline-light" type="button" data-ai-preset="alternatives"><%= __('Alternatives') %></button>
          </div>
        </form>
      </div>
      <p class="small ai-muted mt-3 mb-0"><%= __('Daily limit: {n} requests per user.', { n: aiStatus.dailyLimit }) %></p>
    <% } %>
  </div>
</aside>
