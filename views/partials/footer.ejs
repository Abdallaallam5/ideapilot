        <ul class="list-unstyled small">
          <% if (currentUser) { %>
            <li><a href="/dashboard"><%= __('Dashboard') %></a></li>
            <li><a href="/projects/new"><%= __('Create an idea') %></a></li>
            <li><a href="/settings"><%= __('Settings') %></a></li>
          <% } else { %>
            <li><a href="/register"><%= __('Create an account') %></a></li>
            <li><a href="/login"><%= __('Log in') %></a></li>
          <% } %>
        </ul>
