<div class="roadmap-task" draggable="true" data-task-id="<%= t.id %>" data-task-status="<%= t.status %>">
  <span class="drag-handle" aria-hidden="true"><i data-lucide="grip-vertical" class="icon-sm"></i></span>
  <button class="status-toggle <%= t.status === 'completed' ? 'done' : '' %>" type="button" data-toggle-complete aria-label="<%= __(t.status === 'completed' ? 'Mark as to do' : 'Mark as completed') %>: <%= t.title %>">
    <i data-lucide="<%= t.status === 'completed' ? 'check-circle-2' : 'circle' %>"></i>
  </button>
  <div class="flex-grow-1 min-w-0">
    <a class="fw-semibold text-decoration-none <%= t.status === 'completed' ? 'task-title-done' : 'text-reset' %>" href="/projects/<%= project._id %>/tasks/<%= t.id %>/edit"><%= t.title %></a>
    <div class="d-flex flex-wrap gap-2 align-items-center mt-1">
      <span class="status-badge status-<%= t.status %>" data-status-badge><%= fmt.label(t.status) %></span>
      <%- include('../tasks/_badges', { t }) %>
      <% t.dependencyTasks.forEach(function (d) { %><a class="dep-chip <%= d.status !== 'completed' ? 'open' : '' %>" href="/projects/<%= project._id %>/tasks/<%= d.id %>/edit" title="<%= __('Depends on') %>"><i data-lucide="corner-down-right" class="icon-xs"></i><%= d.title %></a><% }) %>
    </div>
  </div>
  <div class="d-flex flex-column d-md-none">
    <button class="btn btn-icon" type="button" data-move-task="up" aria-label="<%= __('Move up') %>"><i data-lucide="chevron-up" class="icon-sm"></i></button>
    <button class="btn btn-icon" type="button" data-move-task="down" aria-label="<%= __('Move down') %>"><i data-lucide="chevron-down" class="icon-sm"></i></button>
  </div>
</div>
