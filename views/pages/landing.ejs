<% pageScripts.push('/vendor/cytoscape/cytoscape.min.js', '/static/js/graph-styles.js', '/static/js/landing.js') %>
<section class="hero">
  <div class="container">
    <div class="row align-items-center gy-5">
      <div class="col-lg-6">
        <span class="hero-badge"><i data-lucide="sparkles" class="icon-xs"></i> <%= __('From first thought to finished work') %></span>
        <h1 class="hero-title"><%= __('Turn Your Ideas Into Action.') %></h1>
        <p class="hero-lead"><%= __('IdeaPilot is a visual workspace for any idea: a business, an app, a research question, a trip, a new skill. Map how the pieces connect, spot risks and assumptions, build a roadmap, and track every task until it is done.') %></p>
        <div class="d-flex flex-wrap gap-2 mt-4">
          <% if (currentUser) { %>
            <a class="btn btn-primary btn-lg" href="/dashboard"><%= __('Go to your dashboard') %> <i data-lucide="arrow-right" class="icon-sm"></i></a>
          <% } else { %>
            <a class="btn btn-primary btn-lg" href="/register"><%= __('Start for free') %> <i data-lucide="arrow-right" class="icon-sm"></i></a>
            <a class="btn btn-outline-light btn-lg" href="#how-it-works"><%= __('See how it works') %></a>
          <% } %>
        </div>
        <ul class="hero-points">
          <li><i data-lucide="check" class="icon-xs"></i> <%= __('Works fully without AI') %></li>
          <li><i data-lucide="check" class="icon-xs"></i> <%= __('Every plan change is versioned') %></li>
          <li><i data-lucide="check" class="icon-xs"></i> <%= __('AI suggestions need your approval') %></li>
        </ul>
      </div>
      <div class="col-lg-6">
        <div class="preview-window">
          <div class="preview-bar"><span></span><span></span><span></span><em><%= __('Example map. Drag the nodes around.') %></em></div>
          <div id="landingGraph" class="preview-graph" role="img" aria-label="<%= __('An example idea map showing a community garden idea connected to goals, an assumption, a risk, a resource and a milestone.') %>"></div>
          <div class="preview-legend">
            <span class="lg idea"><%= __('Idea') %></span><span class="lg goal"><%= __('Goal') %></span><span class="lg assumption"><%= __('Assumption') %></span><span class="lg risk"><%= __('Risk') %></span><span class="lg resource"><%= __('Resource') %></span><span class="lg milestone"><%= __('Milestone') %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section workflow-strip" aria-label="<%= __('Workflow') %>">
  <div class="container">
    <ol class="workflow">
      <li><span class="wf-icon"><i data-lucide="lightbulb"></i></span><strong><%= __('Idea') %></strong><small><%= __('Capture it in a sentence') %></small></li>
      <li aria-hidden="true" class="wf-arrow"><i data-lucide="chevron-right"></i></li>
      <li><span class="wf-icon"><i data-lucide="network"></i></span><strong><%= __('Map') %></strong><small><%= __('Connect goals, risks, resources') %></small></li>
      <li aria-hidden="true" class="wf-arrow"><i data-lucide="chevron-right"></i></li>
      <li><span class="wf-icon"><i data-lucide="milestone"></i></span><strong><%= __('Plan') %></strong><small><%= __('Phases, milestones, tasks') %></small></li>
      <li aria-hidden="true" class="wf-arrow"><i data-lucide="chevron-right"></i></li>
      <li><span class="wf-icon"><i data-lucide="rocket"></i></span><strong><%= __('Execute') %></strong><small><%= __('Track progress, replan') %></small></li>
    </ol>
  </div>
</section>

<section class="section" id="features">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow"><%= __('Features') %></p>
      <h2><%= __('Everything between the idea and the result') %></h2>
      <p class="text-muted"><%= __('IdeaPilot keeps your thinking, your plan and your progress in one place, so nothing gets lost between them.') %></p>
    </div>
    <div class="row g-4">
      <% [
        { icon: 'network', title: 'Interactive idea maps', text: 'Add ideas, goals, assumptions, risks, resources, decisions, milestones, tasks and notes. Connect them with meaningful relationships like “depends on” or “tests”.' },
        { icon: 'scan-search', title: 'Structured analysis', text: 'Keep a living summary of goals, core components, assumptions, risks, unknowns, opportunities and next steps. Pull items straight from your map.' },
        { icon: 'milestone', title: 'Roadmaps with phases', text: 'Organize work into phases and milestones, set priorities and optional deadlines, and see progress per phase.' },
        { icon: 'kanban', title: 'List and Kanban tasks', text: 'Manage tasks in a list or drag them across a board. Dependencies are validated, and blocked or overdue work is flagged.' },
        { icon: 'git-branch', title: 'Replanning and versions', text: 'When an assumption fails, IdeaPilot traces what it affects and proposes changes. Accepted changes become a new plan version you can always roll back.' },
        { icon: 'sparkles', title: 'Optional AI copilot', text: 'Connect an AI provider to analyze ideas, suggest components and draft roadmaps. Suggestions arrive as proposals you approve or reject.' },
      ].forEach(function (f) { %>
        <div class="col-md-6 col-lg-4">
          <div class="feature-card"><span class="feature-icon"><i data-lucide="<%= f.icon %>"></i></span><h3 class="h5"><%= __(f.title) %></h3><p><%= __(f.text) %></p></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section-alt" id="how-it-works">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow"><%= __('How it works') %></p>
      <h2><%= __('Four steps from “what if” to “done”') %></h2>
    </div>
    <div class="row g-4 steps">
      <% [
        { n: 1, title: 'Describe your idea', text: 'Give it a title and a short description. Add the outcome you want, your audience, time, budget or constraints if you know them.' },
        { n: 2, title: 'Map it visually', text: 'Break the idea into components on an interactive map. Mark what you are assuming, what could go wrong, and what you already have.' },
        { n: 3, title: 'Build the plan', text: 'Turn the map into phases, milestones and tasks, by hand or with an AI draft. Set priorities and link tasks to the parts of the map they serve.' },
        { n: 4, title: 'Execute and adapt', text: 'Move tasks forward, watch progress, and when something important changes, replan. Every version and decision stays in your history.' },
      ].forEach(function (s) { %>
        <div class="col-md-6 col-lg-3"><div class="step-card"><span class="step-num"><%= s.n %></span><h3 class="h6"><%= __(s.title) %></h3><p><%= __(s.text) %></p></div></div>
      <% }) %>
    </div>
    <div class="example-flow mt-5">
      <h3 class="h5 mb-3"><%= __('Example: learning to play the piano in six months') %></h3>
      <div class="row g-3">
        <div class="col-md-3"><div class="ex-card"><span class="ex-tag idea"><%= __('Idea') %></span><p><%= __('Learn to play three songs for a family gathering.') %></p></div></div>
        <div class="col-md-3"><div class="ex-card"><span class="ex-tag map"><%= __('Map') %></span><p><%= __('Goal: play by ear. Assumption: 30 minutes a day is realistic. Risk: no teacher feedback. Resource: a used keyboard.') %></p></div></div>
        <div class="col-md-3"><div class="ex-card"><span class="ex-tag plan"><%= __('Plan') %></span><p><%= __('Phase 1: fundamentals. Phase 2: first song. Milestone: play song one without stopping.') %></p></div></div>
        <div class="col-md-3"><div class="ex-card"><span class="ex-tag exec"><%= __('Execute') %></span><p><%= __('Daily practice tasks on the board. The time assumption fails in month two, so replanning shifts the schedule to weekends.') %></p></div></div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="faq">
  <div class="container page-narrow">
    <div class="section-head">
      <p class="eyebrow"><%= __('FAQ') %></p>
      <h2><%= __('Questions, answered') %></h2>
    </div>
    <div class="accordion faq" id="faqAccordion">
      <% [
        { q: 'What kinds of ideas can I plan?', a: 'Anything with a goal: businesses, websites and apps, learning goals, research, creative projects, events, home projects. Node types such as goals, assumptions and risks apply to every domain.' },
        { q: 'Do I need AI to use IdeaPilot?', a: 'No. Maps, analysis, roadmaps, tasks, replanning and version history all work by hand. The AI copilot is optional and only available when the server has an AI provider configured.' },
        { q: 'Will the AI change my plan without asking?', a: 'Never. AI output is shown as a proposal. You choose which items to apply, and plan changes are saved as a new version so you can restore the previous one.' },
        { q: 'What happens when an assumption turns out to be wrong?', a: 'Mark it as changed or invalidated from the map. IdeaPilot follows the connections on your map and the dependencies between tasks to show what is affected, then proposes changes you can accept or reject.' },
        { q: 'Is my data private?', a: 'Your projects are only visible to your account. Passwords are hashed with bcrypt, sessions are stored server-side, and every request is checked for project ownership.' },
      ].forEach(function (item, i) { %>
        <div class="accordion-item">
          <h3 class="accordion-header">
            <button class="accordion-button <%= i ? 'collapsed' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#faq<%= i %>" aria-expanded="<%= i ? 'false' : 'true' %>" aria-controls="faq<%= i %>"><%= __(item.q) %></button>
          </h3>
          <div id="faq<%= i %>" class="accordion-collapse collapse <%= i ? '' : 'show' %>" data-bs-parent="#faqAccordion"><div class="accordion-body"><%= __(item.a) %></div></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section cta-band">
  <div class="container text-center">
    <h2><%= __('Your next idea deserves a plan.') %></h2>
    <p><%= __('Create a free account and map your first idea in minutes.') %></p>
    <a class="btn btn-light btn-lg" href="<%= currentUser ? '/projects/new' : '/register' %>"><%= __(currentUser ? 'Create an idea' : 'Create your account') %></a>
  </div>
</section>
