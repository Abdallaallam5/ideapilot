<% pageScripts.push('/static/js/guide.js') %>
<%
  const chapters = [
    { t: 0, icon: 'languages', title: 'Switch to Arabic and tour the home page' },
    { t: 17, icon: 'user-plus', title: 'Create an account' },
    { t: 28, icon: 'lightbulb', title: 'Add a new idea' },
    { t: 37, icon: 'network', title: 'Build the idea map' },
    { t: 79, icon: 'scan-search', title: 'Analyze the idea' },
    { t: 92, icon: 'milestone', title: 'Plan phases, milestones and tasks' },
    { t: 117, icon: 'kanban', title: 'Track tasks in a list and on the board' },
    { t: 138, icon: 'refresh-cw', title: 'Replan when an assumption changes' },
    { t: 158, icon: 'history', title: 'History and plan versions' },
    { t: 163, icon: 'sparkles', title: 'Ask the IdeaPilot assistant' },
  ];
  const clock = (s) => Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
%>
<section class="hero guide-hero">
  <div class="container">
    <div class="section-head text-center mx-auto guide-head">
      <span class="hero-badge"><i data-lucide="play-circle" class="icon-xs"></i> <%= __('Video guide') %></span>
      <h1 class="hero-title guide-title"><%= __('Learn IdeaPilot in 3 minutes') %></h1>
      <p class="hero-lead mx-auto"><%= __('Follow one real example from start to finish: a small home bakery goes from a first idea to a map, a plan, tasks and a changed plan. The video has Arabic captions.') %></p>
    </div>

    <div class="row g-4 align-items-start guide-player-row">
      <div class="col-lg-8">
        <div class="guide-player">
          <video id="guideVideo" controls preload="metadata" playsinline poster="/static/videos/ideapilot-guide-poster.jpg" aria-label="<%= __('IdeaPilot walkthrough video with Arabic captions') %>">
            <source src="/static/videos/ideapilot-guide-ar.mp4" type="video/mp4">
            <%= __('Your browser cannot play this video.') %> <a href="/static/videos/ideapilot-guide-ar.mp4"><%= __('Download it') %></a>
          </video>
        </div>
      </div>
      <div class="col-lg-4">
        <nav class="guide-chapters" aria-label="<%= __('Chapters') %>">
          <h2 class="guide-chapters-title"><i data-lucide="list-video" class="icon-sm"></i> <%= __('Chapters') %></h2>
          <ol>
            <% chapters.forEach(function (c, i) { %>
              <li>
                <button type="button" class="guide-chapter" data-chapter-time="<%= c.t %>">
                  <span class="guide-chapter-icon"><i data-lucide="<%= c.icon %>" class="icon-sm"></i></span>
                  <span class="guide-chapter-text"><%= __(c.title) %></span>
                  <span class="guide-chapter-time" dir="ltr"><%= clock(c.t) %></span>
                </button>
              </li>
            <% }) %>
          </ol>
        </nav>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow"><%= __('What you will learn') %></p>
      <h2><%= __('Everything you need to take an idea all the way') %></h2>
    </div>
    <div class="row g-4">
      <% [
        { icon: 'network', title: 'Map the idea', text: 'Add goals, assumptions, risks and resources, connect them, and drag them into place. Everything saves on its own.' },
        { icon: 'scan-search', title: 'See it clearly', text: 'Pull the map into an analysis with a summary, goals, assumptions and risks in one place.' },
        { icon: 'milestone', title: 'Turn it into a plan', text: 'Create phases, milestones and tasks with priorities, deadlines and tasks that must finish first.' },
        { icon: 'kanban', title: 'Get it done', text: 'Change a task’s status from the list or drag its card across the board.' },
        { icon: 'refresh-cw', title: 'Adapt when things change', text: 'Mark an assumption as wrong and review a proposed new plan before anything changes.' },
        { icon: 'sparkles', title: 'Ask for help', text: 'The IdeaPilot assistant answers in your language and only suggests. You approve every change.' },
      ].forEach(function (f) { %>
        <div class="col-md-6 col-lg-4">
          <div class="feature-card h-100">
            <span class="feature-icon"><i data-lucide="<%= f.icon %>"></i></span>
            <h3 class="h6"><%= __(f.title) %></h3>
            <p class="mb-0"><%= __(f.text) %></p>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="guide-cta">
      <div>
        <h2 class="h4 mb-1"><%= __('Ready to try it with your own idea?') %></h2>
        <p class="mb-0"><%= __('It takes a minute to start, and every tool also works by hand.') %></p>
      </div>
      <% if (currentUser) { %>
        <a class="btn btn-primary btn-lg" href="/projects/new"><i data-lucide="plus" class="icon-sm"></i> <%= __('Create an idea') %></a>
      <% } else { %>
        <a class="btn btn-primary btn-lg" href="/register"><%= __('Start for free') %> <i data-lucide="arrow-right" class="icon-sm"></i></a>
      <% } %>
    </div>
  </div>
</section>
