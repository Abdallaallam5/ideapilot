<% pageScripts.push('/static/js/guide.js') %>
<%
  const chapters = [
    { t: 0, icon: 'languages', title: 'Switch to Arabic and tour the home page' },
    { t: 14, icon: 'user-plus', title: 'Create an account' },
    { t: 24, icon: 'wand-sparkles', title: 'Write your idea in your own words' },
    { t: 51, icon: 'network', title: 'See it drawn as a map' },
    { t: 65, icon: 'scan-search', title: 'The analysis fills itself in' },
    { t: 71, icon: 'milestone', title: 'A ready-made roadmap, plus a stage you write' },
    { t: 93, icon: 'list-checks', title: 'Write your tasks and track them' },
    { t: 116, icon: 'clipboard-check', title: 'Review your idea and tasks' },
  ];
  const clock = (s) => Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
%>
<section class="hero guide-hero">
  <div class="container">
    <div class="section-head text-center mx-auto guide-head">
      <span class="hero-badge"><i data-lucide="play-circle" class="icon-xs"></i> <%= __('Video guide') %></span>
      <h1 class="hero-title guide-title"><%= __('Learn IdeaPilot in 2 minutes') %></h1>
      <p class="hero-lead mx-auto"><%= __('Follow one real example from start to finish: a small home bakery is written in plain words and becomes a map, a roadmap, tasks and a simple review. The video has Arabic captions.') %></p>
    </div>

    <div class="row g-4 align-items-start guide-player-row">
      <div class="col-lg-8">
        <div class="guide-player">
          <video id="guideVideo" controls preload="metadata" playsinline poster="<%= asset('/static/videos/ideapilot-guide-poster.jpg') %>" aria-label="<%= __('IdeaPilot walkthrough video with Arabic captions') %>">
            <source src="<%= asset('/static/videos/ideapilot-guide-ar.mp4') %>" type="video/mp4">
            <%= __('Your browser cannot play this video.') %> <a href="<%= asset('/static/videos/ideapilot-guide-ar.mp4') %>"><%= __('Download it') %></a>
          </video>
        </div>
      </div>
      <div class="col-lg-4">
        <nav class="guide-chapters" aria-label="<%= __('Chapters') %>">
          <h2 class="guide-chapters-title"><i data-lucide="list-video" class="icon-sm"></i> <%= __('Chapters') %></h2>
          <ol>
            <% chapters.forEach(function (c, i) { %>
              <li>
                <button type="button" class="guide-chapter" data-chapter-time="<%= c.t %>">
                  <span class="guide-chapter-icon"><i data-lucide="<%= c.icon %>" class="icon-sm"></i></span>
                  <span class="guide-chapter-text"><%= __(c.title) %></span>
                  <span class="guide-chapter-time" dir="ltr"><%= clock(c.t) %></span>
                </button>
              </li>
            <% }) %>
          </ol>
        </nav>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow"><%= __('What you will learn') %></p>
      <h2><%= __('Everything you need to take an idea all the way') %></h2>
    </div>
    <div class="row g-4">
      <% [
        { icon: 'network', title: 'Map the idea', text: 'Add goals, assumptions, risks and resources, connect them, and drag them into place. Everything saves on its own.' },
        { icon: 'scan-search', title: 'See it clearly', text: 'Your goals, assumptions and risks from the map fill the analysis automatically.' },
        { icon: 'milestone', title: 'Turn it into a plan', text: 'Get a ready-made roadmap with your idea, or describe your stages and IdeaPilot turns them into phases and tasks.' },
        { icon: 'kanban', title: 'Get it done', text: 'Change a task’s status from the list or drag its card across the board.' },
        { icon: 'clipboard-check', title: 'Review it simply', text: 'One page shows your idea, your tasks, what comes next and what needs your attention.' },
        { icon: 'wand-sparkles', title: 'Just write it', text: 'Describe your idea or your tasks in your own words, and IdeaPilot organizes them for you to review.' },
      ].forEach(function (f) { %>
        <div class="col-md-6 col-lg-4">
          <div class="feature-card h-100">
            <span class="feature-icon"><i data-lucide="<%= f.icon %>"></i></span>
            <h3 class="h6"><%= __(f.title) %></h3>
            <p class="mb-0"><%= __(f.text) %></p>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="guide-cta">
      <div>
        <h2 class="h4 mb-1"><%= __('Ready to try it with your own idea?') %></h2>
        <p class="mb-0"><%= __('It takes a minute to start, and every tool also works by hand.') %></p>
      </div>
      <% if (currentUser) { %>
        <a class="btn btn-primary btn-lg" href="/projects/new"><i data-lucide="plus" class="icon-sm"></i> <%= __('Create an idea') %></a>
      <% } else { %>
        <a class="btn btn-primary btn-lg" href="/register"><%= __('Start for free') %> <i data-lucide="arrow-right" class="icon-sm"></i></a>
      <% } %>
    </div>
  </div>
</section>
