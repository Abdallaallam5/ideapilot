<section class="container page-narrow py-5">
  <a class="back-link" href="/projects/<%= values._id %>/map"><i data-lucide="arrow-left" class="icon-sm"></i> <%= __('Back to workspace') %></a>
  <h1 class="h2 mt-2 mb-4"><%= __('Edit project') %></h1>
  <div class="card surface-card">
    <div class="card-body p-4">
      <%- include('../partials/formErrors', { errors }) %>
      <form action="/projects/<%= values._id %>/update" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <%- include('_fields', { values, errors }) %>
        <div class="row g-3 mb-2">
          <div class="col-md-6">
            <label class="form-label" for="stage"><%= __('Stage') %></label>
            <select class="form-select" id="stage" name="stage">
              <% C.PROJECT_STAGES.forEach(function (s) { %><option value="<%= s %>" <%= values.stage === s ? 'selected' : '' %>><%= fmt.label(s) %></option><% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="status"><%= __('Status') %></label>
            <select class="form-select" id="status" name="status">
              <% C.PROJECT_STATUSES.forEach(function (s) { %><option value="<%= s %>" <%= values.status === s ? 'selected' : '' %>><%= fmt.label(s) %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="d-flex justify-content-between flex-wrap gap-2 mt-4">
          <button class="btn btn-outline-danger" type="button" data-confirm="<%= __('Delete “{title}” and all of its maps, plans, tasks and history? This cannot be undone.', { title: values.title }) %>" data-confirm-form="#deleteProjectForm"><i data-lucide="trash-2" class="icon-sm"></i> <%= __('Delete project') %></button>
          <div class="d-flex gap-2">
            <a class="btn btn-light" href="/projects/<%= values._id %>/map"><%= __('Cancel') %></a>
            <button class="btn btn-primary" type="submit" name="returnTo" value="workspace"><%= __('Save changes') %></button>
          </div>
        </div>
      </form>
      <form id="deleteProjectForm" action="/projects/<%= values._id %>/delete" method="post" class="d-none">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      </form>
    </div>
  </div>
</section>
