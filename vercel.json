{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{views,locales,public}/**,node_modules/{bootstrap/dist,cytoscape/dist,lucide/dist/umd,@fontsource/cairo}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
